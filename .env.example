# Required
GOOGLE_GENERATIVE_AI_API_KEY=
AUTH_SECRET=

# Production (Render): public URL of the service, e.g. https://be-my-cupid.onrender.com
# Auth.js also accepts AUTH_TRUST_HOST=true behind reverse proxies.
AUTH_URL=
AUTH_TRUST_HOST=true

# Optional — enables DB persistence (chat history, users, saved matches)
POSTGRES_URL=

# Optional — file uploads / profile photos via Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Optional — resumable chat streams
REDIS_URL=

# Optional — override Gemini image model id
NANO_BANANA_IMAGE_MODEL=
